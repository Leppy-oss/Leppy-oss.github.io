---
import { cn } from "@lib/utils";
import { isExternal } from "@lib/links";
import { SITE } from "@consts";

type Props = {
  href: string;
  underline?: boolean;
}

const { href, underline = true, ...rest } = Astro.props;
const external = isExternal(href, SITE.URL);
const content = (await Astro.slots.render("default")).trim();
---

<a 
  href={href} 
  target={external ? "_blank" : "_self"}
  class={cn("decoration-black/15 dark:decoration-white/30 hover:decoration-black/25 hover:dark:decoration-white/50 text-current hover:text-black hover:dark:text-white transition-colors duration-300 ease-in-out", underline && "underline underline-offset-2")}
  {...rest}
  set:html={content}
/>
