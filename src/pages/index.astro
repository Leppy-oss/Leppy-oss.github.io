---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ResumeRequest from "@components/ResumeRequest.astro";
import Headshot from "@components/Headshot.astro";
import Link from "@components/Link.astro";
import { getEntries } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getEntries("blog")).slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const projects = (await getEntries("projects")).slice(
  0,
  SITE.NUM_PROJECTS_ON_HOMEPAGE,
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-12">
      <section class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div class="space-y-4">
          <h4 class="animate font-semibold text-black dark:text-white">
            Hi, I'm Ryan
          </h4>
          <article class="space-y-4">
            <p class="animate">
              I'm an undergraduate studying CS + Statistics at{" "}
              <Link href="https://college.harvard.edu/">
                Harvard University
              </Link>
              . I grew up in Plano, Texas, where I led a world-class{" "}
              <Link href="https://www.technicbots.com/">
                competitive robotics team
              </Link>{" "}
              and was selected as a{" "}
              <Link href="https://www.societyforscience.org/regeneron-sts/2026-scholars/">
                Regeneron STS Scholar
              </Link>{" "}
              for my research on 3D part-assembly reconstruction. I conduct
              research on embodied coding agents at the{" "}
              <Link href="https://kempnerinstitute.harvard.edu/">
                Harvard Kempner Institute
              </Link>
              .
            </p>
            <p class="animate mb-2!">My current interests include:</p>
            <ul class="animate mt-2!">
              <li>
                Coding agents for embodied tasks: spatial reasoning, code as
                policies, embodied co-design
              </li>
              <li>
                Robotic foundation models: vision-language-action models (VLAs),
                world action models (WAMs)
              </li>
              <li>Computer vision: 3D and 4D scene reconstruction</li>
            </ul>
          </article>
          <ul class="animate flex flex-wrap gap-1">
            {SOCIALS.map((social, index) => (
              <li class="flex gap-1">
                {index > 0 && <span>/</span>}
                <Link href={social.HREF}>{social.NAME}</Link>
              </li>
            ))}
            <li class="flex gap-1">
              <span>/</span>
              <ResumeRequest />
            </li>
          </ul>
        </div>
        <Headshot class="animate" />
      </section>

      <!-- <section class="animate space-y-6"> -->
      <!--   <h5 class="font-semibold text-black dark:text-white">Experience</h5> -->
      <!--   <ul class="list-disc space-y-1.5 pl-5"> -->
      <!--     {EXPERIENCE.map((item) => ( -->
      <!--       <li> -->
      <!--         <span class="text-black dark:text-white">{item.ROLE}</span>,{" "} -->
      <!--         {item.HREF ? ( -->
      <!--           <Link href={item.HREF} external> -->
      <!--             {item.ORG} -->
      <!--           </Link> -->
      <!--         ) : ( -->
      <!--           item.ORG -->
      <!--         )} -->
      <!--         <span class="ml-1 text-sm opacity-75 whitespace-nowrap"> -->
      <!--           {item.DATES} -->
      <!--         </span> -->
      <!--       </li> -->
      <!--     ))} -->
      <!--   </ul> -->
      <!-- </section> -->

      {projects.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">
              Recent projects
            </h5>
            <Link href="/projects">See all projects</Link>
          </div>
          <ul class="flex flex-col gap-4">
            {projects.map((project) => (
              <li>
                <ProjectCard entry={project} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Latest posts</h5>
          <Link href="/blog">See all posts</Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map((post) => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
